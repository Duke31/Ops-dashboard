# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only. Do not expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# SMS Gateway Configuration
# 1. Africa's Talking (Instant free sandbox, no CAC required)
AFRICASTALKING_API_KEY="your-africastalking-api-key"
AFRICASTALKING_USERNAME="sandbox"

# 2. Termii (Alternative Nigerian telecom gateway)
TERMII_API_KEY="your-termii-api-key"
TERMII_SENDER_ID="Emergency"

# Webhook Security Secret
SUPABASE_WEBHOOK_SECRET="your-supabase-webhook-secret"

# GitHub Token for Android Mobile App automated builds
GITHUB_TOKEN="your-github-token"
