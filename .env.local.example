NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Do not expose to the browser.
# Leave unset until you confirm the staff-creation implementation.
SUPABASE_SERVICE_ROLE_KEY=

# SMS (Termii) — server only, never NEXT_PUBLIC_
TERMII_API_KEY=
TERMII_SENDER_ID=
EMERGENCY_SMS_WEBHOOK_SECRET=

# SMS provider: termii | africas_talking (optional auto-detect from keys)
SMS_PROVIDER=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=
# true = live API host, false/omit = sandbox
AFRICASTALKING_LIVE=false
